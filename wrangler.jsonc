{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "jessebaizer",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-01",
  "workers_dev": true,
  // No production route and no custom_domain. Attaching jessebaizer.com is an
  // owner step in docs/SETUP.md. Publishing this config must not change DNS.
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "automate",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ]
}
